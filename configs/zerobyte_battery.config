# ==============================================================================
# ZeroByte Kernel Configuration Fragment
# Target Device : Realme P3 5G (RMX5079 / dongfeng)
# Platform      : Qualcomm Snapdragon 6 Gen 4 (SM6650 / volcano)
# Architecture  : Linux 6.1.y GKI 2.0 (ARM64)
# Focus         : Maximum Battery Efficiency, Lower Thermals & Zero Overhead
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Power Management & Deep Sleep
# ------------------------------------------------------------------------------
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# ------------------------------------------------------------------------------
# 2. Memory & ZRAM Architecture (Default LZ4 Zero-Overhead)
# ------------------------------------------------------------------------------
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_ZRAM_DEF_COMP="lz4"

# ------------------------------------------------------------------------------
# 3. Low-Latency High-Efficiency Networking
# ------------------------------------------------------------------------------
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ------------------------------------------------------------------------------
# 4. Link-Time Optimization (ThinLTO)
# ------------------------------------------------------------------------------
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_NONE is not set

# ------------------------------------------------------------------------------
# 5. Overhead Stripping (Disabled Debug & Tracing Bloatware)
# Preserves KMI struct layouts (task_struct, sched_entity) for OEM DLKM Wi-Fi/Audio
# ------------------------------------------------------------------------------
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_ADVANCED_DEBUG is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set
# CONFIG_KUNIT_DEBUGFS is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_CMA_DEBUGFS is not set
# CONFIG_ANDROID_DEBUG_SYMBOLS is not set
# CONFIG_ANDROID_DEBUG_KINFO is not set
